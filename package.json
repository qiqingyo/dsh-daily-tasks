{
  "name": "dsh-daily-tasks",
  "version": "1.0.0",
  "private": true,
  "description": "A calendar-synced daily task checklist for the DeepSeek Harness Web UI.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qiqingyo/dsh-daily-tasks.git"
  },
  "bugs": {
    "url": "https://github.com/qiqingyo/dsh-daily-tasks/issues"
  },
  "homepage": "https://github.com/qiqingyo/dsh-daily-tasks#readme",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
